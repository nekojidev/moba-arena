{
  "name": "moba-arena",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run build -w client && npm start -w server",
    "test": "npm test --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.0.0",
    "fast-check": "^4.10.3",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
