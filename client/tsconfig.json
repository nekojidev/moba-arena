{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Клієнт збирає Vite, а не Node: модулі розв'язує збирач, а в коді доступні DOM і import.meta.env.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["src"]
}
