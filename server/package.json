    "bench:rss": "node scripts/rss-benchmark.js",
    "demo:block": "node scripts/block-demo.js",
    "demo:error": "node scripts/error-demo.js",
    "bench:codec": "node scripts/codec-benchmark.js"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "zod": "^4.0.0",
    "@moba-arena/shared": "*"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0"
  }
}
