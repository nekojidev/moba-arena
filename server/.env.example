# Скопіюйте в .env — його підхоплює `node --env-file-if-exists=.env`.
# Тут лише приклади й типові значення; справжніх секретів у цьому файлі немає і бути не повинно.

# Порт HTTP і WebSocket (0 — будь-який вільний).
PORT=3000
# Адреса, на якій слухати. У контейнері — 0.0.0.0, локально — 127.0.0.1.
HOST=127.0.0.1
# Куди писати журнали матчів (NDJSON, з них будуються повтори).
LOG_DIR=./logs
# Каталог зі зібраним клієнтом (npm run build).
CLIENT_DIST=../client/dist
# Рівень логу в stdout: debug, info, warn, error, fatal або silent.
LOG_LEVEL=info
# Версія збірки (git SHA). Її задає Dockerfile; видно в /health, /metrics і в HUD клієнта.
GIT_SHA=dev
# 1 — увімкнути навчальні маршрути /api/slow, /api/debug/crash і ?mode=buffer (лише для дослідів!).
DEBUG_ROUTES=0
# Система зіткнень: hash (просторовий хеш, типово) або naive (перебір пар, для порівняння).
COLLISION=hash

# --- захист ---
# Звідки дозволено відкривати WebSocket (заголовок Origin), через кому, без «/» в кінці.
# Порожньо — будь-звідки (лише для розробки). У ПРОДАКШЕНІ ЗАДАТИ ОБОВ'ЯЗКОВО.
ALLOWED_ORIGINS=
# 1 — пускати клієнтів без заголовка Origin (скрипти), коли ALLOWED_ORIGINS задано. Типово — ні.
ALLOW_NO_ORIGIN=0
# Скільки одночасних WebSocket-з'єднань дозволено з однієї IP-адреси (понад це — HTTP 429).
MAX_CONNECTIONS_PER_IP=32
# 1 — сервер за проксі хостингу: адреса клієнта береться з першого запису X-Forwarded-For.
# Без проксі не вмикати — заголовок може підробити сам клієнт.
TRUST_PROXY=0

# --- ліміти ---
# Скільки кімнат може існувати одночасно.
MAX_ROOMS=20
# Скільки гравців уміщає одна кімната.
MAX_PLAYERS_PER_ROOM=8
# Найбільший кадр WebSocket у байтах (більший — закриття з кодом 1009).
MAX_PAYLOAD_BYTES=4096
# Найбільше тіло HTTP-запиту в байтах (більше — 413).
MAX_BODY_BYTES=4096
# Скільки мс сокет може мовчати після підключення, не надіславши join (далі — код 4002).
JOIN_TIMEOUT_MS=5000
# Період ping у мс; хто пропустив два pong поспіль — того від'єднуємо.
HEARTBEAT_MS=15000
# Скільки керувальних повідомлень (чат, ping…) за секунду дозволено одному клієнту.
RATE_LIMIT_PER_SECOND=10
# Поріг буфера відправки в байтах: понад нього повільному клієнту не шлемо некритичне.
SLOW_CLIENT_BYTES=65536
# Через скільки мс видаляється створена кімната, у яку ніхто не зайшов.
EMPTY_ROOM_TTL_MS=60000
